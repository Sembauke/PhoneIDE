        "text": "if ready:\n    return (",
        "selectionStart": 22,
        "selectionEnd": 22
      },
      "operations": [
        {
          "type": "insert",
          "text": "\n"
        }
      ],
      "expected": {
        "text": "if ready:\n    return (\n        ",
        "selectionStart": 31,
        "selectionEnd": 31
      }
    },
    {
      "name": "backslash uses hanging indentation",
      "initial": {
        "text": "    total = first + \\",
        "selectionStart": 21,
        "selectionEnd": 21
      },
      "operations": [
        {
          "type": "insert",
          "text": "\n"
        }
      ],
      "expected": {
        "text": "    total = first + \\\n        ",
        "selectionStart": 30,
        "selectionEnd": 30
      }
    },
    {
