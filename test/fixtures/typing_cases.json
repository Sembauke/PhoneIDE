{
  "schema_version": 1,
  "description": "Literal input/output fixtures for Python editing regression tests.",
  "cases": [
    {
      "name": "ordinary Enter copies indentation",
      "initial": {
        "text": "    work",
        "selectionStart": 8,
        "selectionEnd": 8
      },
      "operations": [
        {
          "type": "insert",
          "text": "\n"
        }
      ],
      "expected": {
        "text": "    work\n    ",
        "selectionStart": 13,
        "selectionEnd": 13
      }
    },
    {
      "name": "block colon adds an indentation unit",
      "initial": {
        "text": "if ready:",
        "selectionStart": 9,
        "selectionEnd": 9
      },
      "operations": [
        {
          "type": "insert",
          "text": "\n"
        }
      ],
      "expected": {
        "text": "if ready:\n    ",
        "selectionStart": 14,
        "selectionEnd": 14
      }
    },
    {
      "name": "trailing comment preserves block opener",
      "initial": {
        "text": "if ready: # reason",
        "selectionStart": 18,
        "selectionEnd": 18
      },
      "operations": [
        {
          "type": "insert",
          "text": "\n"
        }
      ],
      "expected": {
        "text": "if ready: # reason\n    ",
        "selectionStart": 23,
        "selectionEnd": 23
      }
    },
    {
      "name": "quoted colon is not a block",
      "initial": {
        "text": "    message = \":\"",
        "selectionStart": 17,
        "selectionEnd": 17
      },
      "operations": [
        {
          "type": "insert",
          "text": "\n"
        }
      ],
      "expected": {
        "text": "    message = \":\"\n    ",
        "selectionStart": 22,
        "selectionEnd": 22
      }
    },
    {
      "name": "dict colon is a bracket continuation",
      "initial": {
        "text": "d = {\"a\":",
        "selectionStart": 9,
        "selectionEnd": 9
      },
      "operations": [
        {
          "type": "insert",
          "text": "\n"
        }
      ],
      "expected": {
        "text": "d = {\"a\":\n    ",
        "selectionStart": 14,
        "selectionEnd": 14
      }
    },
    {
      "name": "complete return result dedents",
