    {
      "name": "Enter preserves tab style",
      "initial": {
        "text": "if ready:\n\tif nested:",
        "selectionStart": 21,
        "selectionEnd": 21
      },
      "operations": [
        {
          "type": "insert",
          "text": "\n"
        }
      ],
      "expected": {
        "text": "if ready:\n\tif nested:\n\t\t",
        "selectionStart": 24,
        "selectionEnd": 24
      }
    },
    {
      "name": "indent command shifts the whole line",
      "initial": {
        "text": "alpha",
        "selectionStart": 2,
        "selectionEnd": 2
      },
      "operations": [
        {
          "type": "command",
          "command": "indent"
        }
      ],
      "expected": {
        "text": "    alpha",
        "selectionStart": 6,
        "selectionEnd": 6
      }
    },
    {
      "name": "dedent command preserves relative caret position",
      "initial": {
        "text": "    alpha",
        "selectionStart": 6,
        "selectionEnd": 6
      },
      "operations": [
        {
          "type": "command",
          "command": "dedent"
        }
      ],
      "expected": {
        "text": "alpha",
        "selectionStart": 2,
        "selectionEnd": 2
      }
    },
    {
      "name": "selected lines shift uniformly including string data",
      "initial": {
        "text": "def f():\n    text = \"\"\"\nraw data\n\"\"\"\n    return text",
        "selectionStart": 0,
        "selectionEnd": 52
      },
      "operations": [
        {
          "type": "command",
          "command": "indent"
        }
      ],
      "expected": {
        "text": "    def f():\n        text = \"\"\"\n    raw data\n    \"\"\"\n        return text",
        "selectionStart": 4,
        "selectionEnd": 72
      }
    },
    {
      "name": "selected dedent clamps each code line independently",
